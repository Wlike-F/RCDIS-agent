SERVER_PORT=8080

RCDIS_DATASOURCE_URL=jdbc:postgresql://localhost:5432/rcdis_agent
RCDIS_DATASOURCE_USERNAME=postgres
RCDIS_DATASOURCE_PASSWORD=postgres

# Master passphrase for the AES-256/GCM encryption of API keys stored in the model_provider table.
# Keep it stable: changing it makes previously stored keys undecryptable, and they must be re-entered.
# Leave empty in local development to fall back to a development key (a warning is logged at startup).
RCDIS_PROVIDER_SECRET_KEY=

# Values below only seed the model_provider table on first startup. Providers added or edited
# through the model provider page are stored in PostgreSQL and always take precedence.
DASHSCOPE_API_KEY=
RCDIS_AI_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
RCDIS_AI_DASHSCOPE_CHAT_MODEL=qwen-plus

RCDIS_AI_OLLAMA_BASE_URL=http://localhost:11434
RCDIS_AI_OLLAMA_API_KEY=
RCDIS_AI_OLLAMA_CHAT_MODEL=qwen2.5

RCDIS_FEISHU_ENABLED=false
RCDIS_FEISHU_CLIENT_TYPE=webhook
RCDIS_FEISHU_OPEN_API_BASE_URL=https://open.feishu.cn
RCDIS_FEISHU_APP_ID=
RCDIS_FEISHU_APP_SECRET=
RCDIS_FEISHU_DEFAULT_RECEIVE_ID_TYPE=chat_id
RCDIS_FEISHU_DEFAULT_RECEIVE_ID=
RCDIS_FEISHU_WEBHOOK_URL=
RCDIS_FEISHU_SIGNING_SECRET=
RCDIS_FEISHU_VERIFICATION_TOKEN=
RCDIS_FEISHU_MAX_ATTEMPTS=3
RCDIS_FEISHU_TENANT_TOKEN_REFRESH_SKEW_SECONDS=300

RCDIS_SECURITY_AUTH_REQUIRED=false
RCDIS_SECURITY_JWT_ISSUER=rcdis-agent
RCDIS_SECURITY_JWT_SECRET=rcdis-agent-local-development-secret-change-me
RCDIS_SECURITY_JWT_ACCESS_TOKEN_TTL_MINUTES=120
RCDIS_SECURITY_DEV_USER_ENABLED=true
RCDIS_SECURITY_DEV_USER_ID=admin
RCDIS_SECURITY_DEV_USERNAME=admin
RCDIS_SECURITY_DEV_PASSWORD=admin
RCDIS_SECURITY_DEV_TENANT_ID=default
